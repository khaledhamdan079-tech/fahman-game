APP_ENV=development
APP_NAME=Fahman API
APP_VERSION=0.1.0
API_V1_PREFIX=/v1
DATABASE_URL=sqlite+aiosqlite:///./fahman.db
DATABASE_ECHO=false

# Replace in staging/production with at least 32 random bytes.
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Comma-separated OAuth client IDs accepted by the backend.
GOOGLE_CLIENT_IDS=

# Secret used only by trusted catalogue import scripts. Generate a long random value.
ADMIN_API_KEY=

# Comma-separated application origins, for example:
# CORS_ORIGINS=https://app.example.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Private S3-compatible object storage for question media.
MEDIA_BUCKET=
MEDIA_ENDPOINT_URL=
MEDIA_REGION=auto
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_SIGNED_URL_SECONDS=600
MEDIA_UPLOAD_URL_SECONDS=900
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_AUDIO_BYTES=26214400
MEDIA_MAX_VIDEO_BYTES=104857600
